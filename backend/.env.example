# PMSD backend environment
NODE_ENV=development
PORT=5001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=pmsd
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_MAX_USES=7500

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Lecture access security
ACCESS_LOG_SALT=replace-with-a-random-salt
SOURCE_HEALTH_TIMEOUT_MS=5000

# Payment webhook verification
# Use a long random secret. Never commit the real value.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Optional provider-specific overrides:
# PAYMENT_WEBHOOK_SECRET_STRIPE=replace-me
# PAYMENT_WEBHOOK_SECRET_RAZORPAY=replace-me

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
