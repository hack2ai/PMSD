# PMSD backend environment
NODE_ENV=development
PORT=5001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=pmsd

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Lecture access security
ACCESS_LOG_SALT=replace-with-a-random-salt
SOURCE_HEALTH_TIMEOUT_MS=5000

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
